# ──────────────────────────────────────────────
# Axis Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# Phase 1 — Voice Out
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Phase 1 — Wake Word
PICOVOICE_ACCESS_KEY=

# Phase 2 — Memory (Supabase upgrade)
SUPABASE_URL=
SUPABASE_KEY=

# Phase 3 — Calendar & Email
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Phase 4 — IQ Tool Wrappers

# OutreachIQ (fully wired — copy from OutreachIQ .env)
OUTREACHIQ_URL=
OUTREACHIQ_SUPABASE_URL=
OUTREACHIQ_SUPABASE_KEY=
OUTREACHIQ_APP_PASSWORD=
OUTREACHIQ_DAILY_LIMIT=9000

# PressureIQ
PRESSUREIQ_URL=
PRESSUREIQ_API_KEY=

# SignalIQ
SIGNALIQ_URL=
SIGNALIQ_SUPABASE_URL=
SIGNALIQ_SUPABASE_KEY=

# CompatibleIQ
COMPATIBLEIQ_URL=
COMPATIBLEIQ_API_KEY=

# Phase 5 — Cloud Fallback
ANTHROPIC_API_KEY=
